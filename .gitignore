# Top-level .gitignore for CRIMENET-X
# Ignore Python virtual environments
venv/
backend/venv/
.env
*.pyc
__pycache__/
*.pyo
*.pyd
.python-version

# Ignore SQLite DB files and local databases
backend/app/crimenetx.db
*.db
*.sqlite3

# Ignore pipenv / poetry / pip caches
.pip-wheel-metadata/
htmlcov/
.mypy_cache/
.pytest_cache/
.coverage
coverage.xml

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Keep package-lock.json tracked to ensure reproducible frontend installs
# package-lock.json (no longer ignored)

# Vite / dev server
dist/
.cache/

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Secrets and local environment overrides
.env.local
.env.*.local
secrets/

# Others
tmp/
temp/
*.swp

# Allow customizable exceptions below this line
# e.g., to keep package-lock.json, remove/comment out the package-lock.json entry above
