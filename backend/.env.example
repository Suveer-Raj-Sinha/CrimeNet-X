# Copy to .env and adjust as needed. All of these have working defaults for
# the demo — you do not need a .env file to run the MVP.

SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# "memory" (default, no external services) or "neo4j"
GRAPH_BACKEND=memory
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

DATABASE_URL=sqlite:///./crimenet_x.db
